# Local values come from `npx supabase status -o env` at the repo root.
# Read at request time (not build time), so one build or image works anywhere.
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_PUBLISHABLE_KEY=
# Optional: the URL browsers use, when it differs from SUPABASE_URL (`make lan` sets it for phones).
# SUPABASE_BROWSER_URL=
# Optional: the address phones use to reach this app, for the join QR code (`make lan` sets it).
# PUBLIC_ORIGIN=
